# Copy to .env. Never commit .env. Both Python and TypeScript read this file.

# Postgres (TimescaleDB) and Redis — match infra/docker-compose.yml
DATABASE_URL=postgres://trading:trading@localhost:5435/trading
REDIS_URL=redis://localhost:6375

# Strategy / mode config file (relative to repo root)
STRATEGY_CONFIG=config/strategies.yaml

# Run mode override (shadow | paper | testnet | live); empty = `mode:` from strategies.yaml.
# Lets a second engine run in another mode beside the first (see engine-paper in ecosystem.config.cjs).
MODE=

# Binance keys — not needed in shadow or paper mode.
# testnet: create a key pair at https://testnet.binance.vision (M6)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# live (M7): withdrawals disabled, IP-restricted, separate from testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram (M3) — leave empty to disable
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info
