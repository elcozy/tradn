{
  "name": "@trading/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot (M3) and Fastify API + React UI (M4).",
  "scripts": {
    "telegram": "tsx src/telegram/main.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "api": "tsx src/api/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "test:api": "vitest run --dir test"
  },
  "dependencies": {
    "@trading/contracts": "workspace:*",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "ioredis": "^5.4.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "postgres": "^3.4.4",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "fastify": "^5.0.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lightweight-charts": "^4.2.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12"
  }
}
