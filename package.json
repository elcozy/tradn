{
  "name": "trading",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "migrate": "uv run --project services/research research migrate",
    "gen": "pnpm --filter @trading/contracts gen && uv run --project services/research python -m research.tools.gen_contracts",
    "engine": "pnpm --filter @trading/engine dev",
    "lint": "pnpm -r lint && uv run --project services/research ruff check services/research",
    "test": "pnpm -r test && uv run --project services/research pytest -q",
    "dashboard": "pnpm --filter @trading/dashboard build:web && pnpm --filter @trading/dashboard api",
    "telegram": "pnpm --filter @trading/dashboard telegram",
    "runner": "uv run --project services/research research run-live",
    "ps": "pm2 ls",
    "logs": "pm2 logs --lines 50",
    "start:all": "pnpm --filter @trading/dashboard build:web && pm2 start ecosystem.config.cjs",
    "stop:all": "pm2 delete ecosystem.config.cjs"
  },
  "devDependencies": {
    "pm2": "^5.4.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485"
}
