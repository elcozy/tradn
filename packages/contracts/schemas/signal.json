{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Signal",
  "description": "Entry signal produced by the Python strategy runner, consumed by the engine (Redis stream: signals).",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "ts", "strategy_id", "strategy_type", "symbol", "timeframe", "side", "entry", "stop_price", "tp_price"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "id": { "type": "string", "description": "Deterministic: strategy_id:symbol:timeframe:candle_open_time" },
    "ts": { "type": "string", "format": "date-time" },
    "strategy_id": { "type": "string" },
    "strategy_type": { "type": "string" },
    "symbol": { "type": "string" },
    "timeframe": { "type": "string", "enum": ["1m", "3m", "5m", "15m", "30m", "1h", "2h", "4h", "1d"] },
    "side": { "type": "string", "enum": ["long", "short"] },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "price"],
      "properties": {
        "type": { "type": "string", "enum": ["market", "limit"] },
        "price": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "stop_price": { "type": "number", "exclusiveMinimum": 0 },
    "tp_price": { "type": "number", "exclusiveMinimum": 0 },
    "tp1_price": { "type": "number", "exclusiveMinimum": 0 },
    "size_hint": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "exit": {
      "type": "object",
      "description": "Exit policy params for this instance (from config) so the engine needs no strategy knowledge",
      "additionalProperties": false,
      "properties": {
        "tp1_r": { "type": "number" },
        "tp1_fraction": { "type": "number" },
        "breakeven_r": { "type": "number" },
        "trail_atr_k": { "type": ["number", "null"] },
        "tp_ratchet_atr": { "type": ["number", "null"] },
        "fee_pct": { "type": "number" },
        "max_bars": { "type": ["integer", "null"] }
      }
    },
    "meta": { "type": "object", "description": "Indicator snapshot and reasons for the journal" }
  }
}
