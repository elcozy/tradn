{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EngineCommand",
  "description": "Manual overrides sent to the engine from dashboard or Telegram (Redis stream: engine.commands).",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "ts", "type", "source"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "ts": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "enum": ["dashboard", "telegram", "cli"] },
    "type": { "type": "string", "enum": ["close_position", "close_all", "pause", "resume", "kill", "move_sl", "news_on", "news_off"] },
    "position_id": { "type": "string" },
    "symbol": { "type": "string" },
    "price": { "type": "number" },
    "reason": { "type": "string" }
  }
}
